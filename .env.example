OPENAI_API_KEY=replace-with-your-key
# Optional: lets agents use Claude models
# ANTHROPIC_API_KEY=replace-with-your-key
# Optional: AI runs allowed per day (UTC). Over the limit, fallback rules decide. 0 or unset: no limit
# MERCURIUS_DAILY_AI_LIMIT=400
# Optional: set to 0 when the Management Portal isn't reachable (a public demo); hides portal links
# MERCURIUS_PORTAL_LINKS=0
